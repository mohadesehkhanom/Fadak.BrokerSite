  server {
    listen 80;
    listen [::]:80;

    server_name ffg.ir www.ffg.ir;

    return 301 https://ffg.ir$request_uri;
}


    server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name www.ffg.ir;

    ssl_certificate /etc/letsencrypt/live/ffg.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ffg.ir/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://ffg.ir$request_uri;
}


    server {

    listen 443 ssl;
    listen [::]:443 ssl;

    server_name ffg.ir;

    root /var/www/fadak;
    index index.html;


    ssl_certificate /etc/letsencrypt/live/ffg.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ffg.ir/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;


    location = /home {
    return 301 https://ffg.ir/;
    }

    location = /home/ {
    return 301 https://ffg.ir/;
    }


    rewrite ^/(.*)/$ /$1 permanent;


    location ~* \.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2)$ {
    expires 30d;
    access_log off;
    }


    location / {
    try_files $uri $uri.html $uri/ /index.html;
    }

}